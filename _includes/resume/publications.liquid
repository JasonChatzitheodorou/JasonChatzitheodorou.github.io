<div class="publications">

{% assign publications = site.bibliography | sort: "year" | reverse %}

{% assign current_year = "" %}

{% for pub in publications %}

  {% if pub.year != current_year %}
    {% assign current_year = pub.year %}

    <div class="pub-year-header">
      {{ current_year }}
    </div>
  {% endif %}

  <div class="pub-entry">

    <div class="pub-main">

      <div class="pub-title">
        {% if pub.url %}
          <a href="{{ pub.url }}" target="_blank">
            {{ pub.title }}
          </a>
        {% else %}
          {{ pub.title }}
        {% endif %}
      </div>

      <div class="pub-authors">
        {{ pub.author }}
      </div>

      <div class="pub-venue">
        {% if pub.booktitle %}
          {{ pub.booktitle }}
        {% elsif pub.journal %}
          {{ pub.journal }}
        {% endif %}
      </div>

      {% if pub.note %}
      <div class="pub-note">
        {{ pub.note }}
      </div>
      {% endif %}

    </div>

  </div>

{% endfor %}

</div>